FROM alpine:3.24

ARG BUILD_CORES

ARG NGINX_VER=1.30.7
ARG PHP_VER=8.3.37
ARG LIBICONV_VERSION=1.19
ARG IMAGICK_VERSION=3.8.1
#http://nginx.org/en/download.html
#https://www.php.net/downloads.php
#https://ftp.gnu.org/pub/gnu/libiconv/
#https://pecl.php.net/package/imagick

# Allowed signing keys (full fingerprints, space separated)
# nginx: https://nginx.org/en/pgp_keys.html (pluknet, arut, thresh, sb)
ARG GPG_nginx="D6786CE303D9A9022998DC6CC8464D549AF75C0A 43387825DDB1BB97EC36BA5D007C8D7C15D87369 13C82A63B603576156E30A4EA0EA981B66B0D967 7338973069ED3F443F4D37DFA64FD5B17ADB39A8"
# PHP 8.3 release managers: https://www.php.net/gpg-keys.php (Pierrick Charron, Jakub Zelenka, Eric Mann)
ARG GPG_php="1198C0117593497A5EC5C199286AF1F9897469DC C28D937575603EB4ABB725861C0779DC5C0A9DE4 AFD8691FDAEDF03BDF6E460563F15A9B715376CA"
# GNU libiconv maintainer (Bruno Haible)
ARG GPG_libiconv="E0FFBD975397F77A32AB76ECB6301D9E1BBEAC08"

LABEL description="nginx + php image based on Alpine" \
      maintainer="Schley <info@it-schley.eu>" \
      php_version="PHP v$PHP_VER built from source" \
      nginx_version="nginx v$NGINX_VER built from source"

ARG PHP_MIRROR=https://www.php.net

ARG NGINX_CONF=" \
    --prefix=/nginx \
    --sbin-path=/usr/local/sbin/nginx \
    --http-log-path=/nginx/logs/access.log \
    --error-log-path=/nginx/logs/error.log \
    --pid-path=/nginx/run/nginx.pid \
    --lock-path=/nginx/run/nginx.lock \
    --with-threads \
    --with-file-aio \
    --without-http_geo_module \
    --without-http_autoindex_module \
    --without-http_split_clients_module \
    --without-http_memcached_module \
    --without-http_empty_gif_module \
    --without-http_browser_module"

ARG PHP_CONF=" \
    --prefix=/usr \
    --libdir=/usr/lib/php \
    --datadir=/usr/share/php \
    --sysconfdir=/php/etc \
    --localstatedir=/php/var \
    --with-pear=/usr/share/php \
    --with-config-file-scan-dir=/php/conf.d \
    --with-config-file-path=/php \
    --with-pic \
    --disable-short-tags \
    --without-readline \
    --enable-bcmath=shared \
    --enable-fpm \
    --disable-cgi \
    --enable-mysqlnd \
    --enable-mbstring \
    --with-curl \
    --with-libedit \
    --with-openssl \
    --with-iconv=/usr/local \
    --enable-gd \
    --with-freetype \
    --with-jpeg \
    --with-webp-dir \
    --with-xpm-dir=no \
    --enable-gd-native-ttf \
    --disable-gd-jis-conv \
    --enable-bcmath \
    --with-zlib"

ARG PHP_EXT_LIST=" \
    mysqli \
    ctype \
    sodium \
    dom \
    xml \
    mbstring \
    posix \
    xmlwriter \
    zip \
    zlib \
    sqlite3 \
    pdo_sqlite \
    pdo_pgsql \
    pdo_mysql \
    pcntl \
    curl \
    fileinfo \
    bz2 \
    intl \
    openssl \
    ldap \
    simplexml \
    pgsql \
    ftp \
    exif \
    gmp \
    imap \
    sysvsem"

ARG CUSTOM_BUILD_PKGS=" \
    freetype-dev \
    libsodium-dev \
    openldap-dev \
    gmp-dev \
    icu-dev \
    postgresql-dev \
    libpng-dev \
    libwebp-dev \
    gd-dev \
    libjpeg-turbo-dev \
    libxpm-dev \
    libedit-dev \
    libxml2-dev \
    openssl-dev \
    libbz2 \
    sqlite-dev \
    imap-dev"

ARG CUSTOM_PKGS=" \
    freetype \
    openldap \
    gmp \
    bzip2-dev \
    icu \
    libpq \
    c-client"

COPY rootfs8 /

RUN NB_CORES=${BUILD_CORES-$(getconf _NPROCESSORS_CONF)} \

### Packages installation
 && BUILD_DEPS=" \
    linux-headers \
    libtool \
    build-base \
    pcre-dev \
    zlib-dev \
    wget \
    gnupg \
    autoconf \
    gcc \
    g++ \
    libc-dev \
    libzip-dev \
    make \
    pkgconf \
    curl-dev \
    ca-certificates \
    oniguruma-dev \
    ${CUSTOM_BUILD_PKGS}" \
 && apk -U add \
    ${BUILD_DEPS} \
    s6 \
    su-exec \
    curl \
    libedit \
    libxml2 \
    oniguruma \
    libgomp \
    libsodium \
    openssl \
    libwebp \
    libzip \
    sqlite-libs \
    gd \
    pcre \
    zlib \
    ${CUSTOM_PKGS} \

### Source downloading
 && wget https://nginx.org/download/nginx-${NGINX_VER}.tar.gz -O /tmp/nginx-${NGINX_VER}.tar.gz \
 && wget https://nginx.org/download/nginx-${NGINX_VER}.tar.gz.asc -O /tmp/nginx-${NGINX_VER}.tar.gz.asc \
 && wget ${PHP_MIRROR}/distributions/php-${PHP_VER}.tar.gz -O /tmp/php-${PHP_VER}.tar.gz \
 && wget ${PHP_MIRROR}/distributions/php-${PHP_VER}.tar.gz.asc -O /tmp/php-${PHP_VER}.tar.gz.asc \
 && wget https://ftp.gnu.org/pub/gnu/libiconv/libiconv-${LIBICONV_VERSION}.tar.gz -O /tmp/libiconv-${LIBICONV_VERSION}.tar.gz \
 && wget https://ftp.gnu.org/pub/gnu/libiconv/libiconv-${LIBICONV_VERSION}.tar.gz.sig -O /tmp/libiconv-${LIBICONV_VERSION}.tar.gz.sig \

### Source verification: valid signature AND signer in the pinned fingerprint list
 && export GNUPGHOME="$(mktemp -d)" \
 && for k in pluknet arut thresh sb; do wget -q https://nginx.org/keys/$k.key -O - | gpg -q --import; done \
 && wget -q https://www.php.net/distributions/php-keyring.gpg -O - | gpg -q --import \
 && wget -q https://ftp.gnu.org/gnu/gnu-keyring.gpg -O - | gpg -q --import \
 && verify_sig() { \
      FPR="$(LANG=C gpg --verify "$1" "$2" 2>&1 | sed -n 's#Primary key fingerprint: \(.*\)#\1#p' | tr -d ' ')"; \
      if [ -z "$FPR" ]; then echo "Warning! Invalid GPG signature for $2!"; return 1; fi; \
      case " $3 " in *" $FPR "*) echo "Signature OK for $2 ($FPR)";; *) echo "Warning! Unexpected GPG key $FPR for $2!"; return 1;; esac; \
    } \
 && verify_sig /tmp/nginx-${NGINX_VER}.tar.gz.asc /tmp/nginx-${NGINX_VER}.tar.gz "${GPG_nginx}" \
 && verify_sig /tmp/php-${PHP_VER}.tar.gz.asc /tmp/php-${PHP_VER}.tar.gz "${GPG_php}" \
 && verify_sig /tmp/libiconv-${LIBICONV_VERSION}.tar.gz.sig /tmp/libiconv-${LIBICONV_VERSION}.tar.gz "${GPG_libiconv}" \
 && rm -rf "$GNUPGHOME" \

 && mkdir -p /php/conf.d \
 && mkdir -p /usr/src \
 && tar xzf /tmp/nginx-${NGINX_VER}.tar.gz -C /usr/src \
 && tar xzvf /tmp/php-${PHP_VER}.tar.gz -C /usr/src \
 && tar xzf /tmp/libiconv-${LIBICONV_VERSION}.tar.gz -C /usr/src \

### nginx installation
 && cd /usr/src/nginx-${NGINX_VER} \
 && ./configure --with-cc-opt="-O3 -fPIE -fstack-protector-strong" ${NGINX_CONF} \
 && make -j ${NB_CORES} \
 && make install \

### GNU Libiconv installation
 && cd /usr/src/libiconv-${LIBICONV_VERSION} \
 && ./configure --prefix=/usr/local \
 && make && make install && libtool --finish /usr/local/lib \

### PHP installation
 && mv /usr/src/php-${PHP_VER} /usr/src/php \
 && cd /usr/src/php \
 && ./configure CFLAGS="-O3 -fstack-protector-strong" ${PHP_CONF} \
 && make -j ${NB_CORES} \
 && make install \

# fix line endings so shebangs won't confuse the shell (safety net for Windows checkouts)
 && sed -i 's,\r,,g' /usr/local/bin/* /etc/s6.d/*/* /etc/s6.d/.s6-svscan/* \

# ImageMagick
# && chmod +x /usr/local/bin/docker-php-ext-* \
# && apk add git imagemagick-libs imagemagick-dev imagemagick imagemagick-svg \
# && apk add --no-cache --virtual .phpize-deps $PHPIZE_DEPS \
# && export CFLAGS="$PHP_CFLAGS" CPPFLAGS="$PHP_CPPFLAGS" LDFLAGS="$PHP_LDFLAGS" \
# && pecl install imagick-${IMAGICK_VERSION} \
# && docker-php-ext-enable imagick \
# && apk add --no-cache --virtual .imagick-runtime-deps imagemagick imagemagick-svg \

 && chmod +x /usr/local/bin/docker-php-ext-* \
 && apk add git imagemagick-libs imagemagick-dev imagemagick imagemagick-svg \
 && apk add --no-cache --virtual .phpize-deps $PHPIZE_DEPS \
 && export CFLAGS="$PHP_CFLAGS" CPPFLAGS="$PHP_CPPFLAGS" LDFLAGS="$PHP_LDFLAGS" \
 && mkdir -p /usr/src/php/ext/imagick \
 && curl -fsSL https://github.com/Imagick/imagick/archive/28f27044e435a2b203e32675e942eb8de620ee58.tar.gz | tar xvz -C "/usr/src/php/ext/imagick" --strip 1 \
 && docker-php-ext-install imagick \
 && apk add --no-cache --virtual .imagick-runtime-deps imagemagick imagemagick-svg \

### Strip, clean, install modules
 && chmod u+x /usr/local/bin/* /etc/s6.d/*/* \
 && docker-php-ext-install ${PHP_EXT_LIST} \
 && apk del ${BUILD_DEPS} \
 && rm -rf /tmp/* /var/cache/apk/* /usr/src/* \
 && mkdir -p /nginx/logs /nginx/run /php/php-fpm.d /php/logs /php/run /php/session
